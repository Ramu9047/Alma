# ── Frontend environment variables ────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real values.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8080

# NOTE: There is no VITE_GROQ_API_KEY here and there should never be one.
# VITE_-prefixed variables are bundled into client-side JS and visible to
# any visitor via browser dev tools. The Groq API key lives in backend/.env
# as GROQ_API_KEY and is used exclusively server-side via POST /api/copilot/chat.

