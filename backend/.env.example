# ── Backend environment variables ─────────────────────────────────────────
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# JWT signing secret — minimum 32 bytes, used by JwtService (HMAC-SHA256)
ALMA_JWT_SECRET=your-minimum-32-byte-secret-key-here-change-this

# JWT token expiry in milliseconds (default: 86400000 = 24 hours)
ALMA_JWT_EXPIRATION_MS=86400000

# Groq API key for live LLM Copilot integration
# Get yours at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
