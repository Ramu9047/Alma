# ═══════════════════════════════════════════════════════════════
# Alma — Academic Command Center  |  Root Environment Configuration
# ═══════════════════════════════════════════════════════════════

# Security — JWT secret key for signing auth tokens (minimum 32 characters)
ALMA_JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_here

# JWT token expiration in milliseconds (default: 86400000 = 24 hours)
ALMA_JWT_EXPIRATION_MS=86400000

# Groq LLM API key for AI Copilot live integration (optional)
GROQ_API_KEY=gsk_your_groq_api_key_here

# MongoDB Connection URI (points to 'mongodb' service on Docker network)
MONGODB_URI=mongodb://mongodb:27017/alma_db
